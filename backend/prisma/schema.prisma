generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model asset_types {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  assets      assets[]
}

model assets {
  id            Int            @id @default(autoincrement())
  asset_type_id Int
  rfid_uid      String         @unique @db.VarChar(50)
  label         String?        @db.VarChar(100)
  is_available  Boolean?       @default(true)
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  asset_types   asset_types    @relation(fields: [asset_type_id], references: [id], onUpdate: NoAction)
  borrow_items  borrow_items[]

  @@index([is_available], map: "idx_assets_available")
}

model borrow_items {
  id              Int             @id @default(autoincrement())
  session_id      Int
  asset_id        Int
  borrowed_at     DateTime?       @default(now()) @db.Timestamp(6)
  returned_at     DateTime?       @db.Timestamp(6)
  assets          assets          @relation(fields: [asset_id], references: [id], onUpdate: NoAction)
  borrow_sessions borrow_sessions @relation(fields: [session_id], references: [id], onUpdate: NoAction)
}

model borrow_sessions {
  id           Int            @id @default(autoincrement())
  user_id      Int
  status       String         @default("active") @db.VarChar(20)
  photo_path   String?        @db.VarChar(255)
  borrowed_at  DateTime?      @default(now()) @db.Timestamp(6)
  last_updated DateTime?      @default(now()) @db.Timestamp(6)
  borrow_items borrow_items[]
  users        users          @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([user_id, status], map: "idx_borrow_sessions_user_status")
}

model users {
  id              Int               @id @default(autoincrement())
  nrp             String            @unique @db.VarChar(20)
  name            String            @db.VarChar(100)
  rfid_uid        String            @unique @db.VarChar(50)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  borrow_sessions borrow_sessions[]
}
