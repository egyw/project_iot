    {
        "id": "node-http-stats",
        "type": "http request",
        "z": "flow-stats",
        "name": "GET /api/stats/overview",
        "method": "GET",
        "ret": "txt",
        "paytoqs": "ignore",
        "url": "http://127.0.0.1:3001/api/stats/overview",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 660,
