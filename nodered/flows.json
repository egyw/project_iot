    {
        "id": "node-comment-flow1",
        "type": "comment",
        "z": "flow-events",
        "name": "🔔 Flow 1 — MQTT Event Monitor: Subscribe smartlab/events, parse JSON, switch by event type, display notifications",
        "info": "",
        "x": 420,
        "y": 100,
        "wires": []
    },
    {
        "id": "node-mqtt-events",
        "type": "mqtt in",
        "z": "flow-events",
        "name": "MQTT: smartlab/events",
        "topic": "smartlab/events",
        "qos": "1",
        "datatype": "utf8",
        "broker": "mqtt-broker-local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 200,
        "wires": [
            ["node-parse-event"]
        ]
    },
    {
        "id": "node-parse-event",
        "type": "function",
        "z": "flow-events",
        "name": "Parse Event JSON",
        "func": "try {\n    const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n    msg.payload = data;\n    msg.event = data.event;\n    msg.timestamp = data.timestamp;\n    msg.eventData = data.data;\n    return msg;\n} catch (e) {\n    node.warn('Failed to parse event JSON: ' + e.message);\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
            ["node-switch-event"]
        ]
    },
    {
        "id": "node-switch-event",
        "type": "switch",
        "z": "flow-events",
        "name": "Switch Event Type",
        "property": "event",
        "propertyType": "msg",
        "rules": [
            { "t": "eq", "v": "BORROW_CREATED", "vt": "str" },
            { "t": "eq", "v": "RETURN_CONFIRMED", "vt": "str" }
        ],
        "checkall": "false",
        "repair": false,
        "outputs": 2,
        "x": 610,
        "y": 200,
        "wires": [
            ["node-format-borrow"],
            ["node-format-return"]
        ]
    },
    {
        "id": "node-format-borrow",
        "type": "function",
        "z": "flow-events",
        "name": "Format Borrow Event",
        "func": "const d = msg.eventData;\nconst ts = new Date(msg.timestamp).toLocaleTimeString('id-ID');\nmsg.payload = `🟢 BORROW — Session #${d.session_id} | User ID: ${d.user_id} | ${d.asset_count} asset(s) | ${ts}`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 160,
        "wires": [
            ["node-ui-event-text", "node-notif-borrow"]
        ]
    },
    {
        "id": "node-format-return",
        "type": "function",
        "z": "flow-events",
        "name": "Format Return Event",
        "func": "const d = msg.eventData;\nconst ts = new Date(msg.timestamp).toLocaleTimeString('id-ID');\nmsg.payload = `🔵 RETURN — Session #${d.session_id} | ${d.returned_count} item(s) returned | Status: ${d.new_status} | ${ts}`;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 240,
        "wires": [
            ["node-ui-event-text", "node-notif-return"]
        ]
    },
