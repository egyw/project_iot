    {
        "id": "node-comment-flow2",
        "type": "comment",
        "z": "flow-heartbeat",
        "name": "💓 Flow 2 — Heartbeat: Subscribe smartlab/heartbeat, parse state, show device status, trigger OFFLINE after 60s timeout",
        "info": "",
