    {
        "id": "node-set-auth-stats",
        "type": "function",
        "z": "flow-stats",
        "name": "Set Auth Header (Stats)",
        "func": "// ╔══════════════════════════════════════════════════════╗\n// ║  GANTI TOKEN DI BAWAH DENGAN JWT ADMIN YANG VALID  ║\n// ╚══════════════════════════════════════════════════════╝\nconst ADMIN_TOKEN = 'ADMIN_TOKEN';\n\nmsg.headers = {\n    'Authorization': 'Bearer ' + ADMIN_TOKEN,\n    'Content-Type': 'application/json'\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
