        "z": "flow-activity",
        "name": "Parse Activity → HTML Table",
        "func": "try {\n    const body = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n    const rows = body.data;\n\n    if (!rows || rows.length === 0) {\n        msg.payload = '<p style=\"color:#6c7086;text-align:center;padding:20px;\">No recent activity</p>';\n        return msg;\n    }\n\n    let html = `\n    <style>\n        .activity-table {\n            width: 100%;\n            border-collapse: collapse;\n            font-family: 'Segoe UI', sans-serif;\n            font-size: 13px;\n        }\n        .activity-table th {\n            background: #313244;\n            color: #cdd6f4;\n            padding: 10px 12px;\n            text-align: left;\n            font-weight: 600;\n            border-bottom: 2px solid #45475a;\n        }\n        .activity-table td {\n            padding: 8px 12px;\n            border-bottom: 1px solid #313244;\n            color: #bac2de;\n        }\n        .activity-table tr:hover td {\n            background: #1e1e2e;\n        }\n        .badge-borrow {\n            background: #a6e3a1; color: #1e1e2e;\n            padding: 2px 8px; border-radius: 4px;\n            font-weight: 600; font-size: 11px;\n        }\n        .badge-return {\n            background: #89b4fa; color: #1e1e2e;\n            padding: 2px 8px; border-radius: 4px;\n            font-weight: 600; font-size: 11px;\n        }\n    </style>\n    <table class=\"activity-table\">\n        <thead>\n            <tr>\n                <th>Type</th>\n                <th>User</th>\n                <th>NRP</th>\n                <th>Items</th>\n                <th>Time</th>\n            </tr>\n        </thead>\n        <tbody>`;\n\n    rows.forEach(row => {\n        const badgeClass = row.type === 'BORROW' ? 'badge-borrow' : 'badge-return';\n        const icon = row.type === 'BORROW' ? '📦' : '↩️';\n        const ts = new Date(row.timestamp).toLocaleString('id-ID', {\n            day: '2-digit', month: 'short', year: 'numeric',\n            hour: '2-digit', minute: '2-digit'\n        });\n\n        html += `\n            <tr>\n                <td><span class=\"${badgeClass}\">${icon} ${row.type}</span></td>\n                <td>${row.user_name}</td>\n                <td>${row.user_nrp}</td>\n                <td style=\"text-align:center;\">${row.item_count}</td>\n                <td>${ts}</td>\n            </tr>`;\n    });\n\n    html += `\n        </tbody>\n    </table>`;\n\n    msg.payload = html;\n    return msg;\n} catch (e) {\n    node.warn('Failed to parse activity: ' + e.message);\n    msg.payload = '<p style=\"color:#f38ba8;\">Error loading activity data</p>';\n    return msg;\n}",
