        "y": 40,
        "wires": []
    },
    {
        "id": "node-mqtt-heartbeat",
        "type": "mqtt in",
        "z": "flow-heartbeat",
        "name": "MQTT: smartlab/heartbeat",
        "topic": "smartlab/heartbeat",
        "qos": "0",
        "datatype": "utf8",
        "broker": "mqtt-broker-local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 170,
        "y": 140,
        "wires": [
            ["node-parse-heartbeat"]
        ]
    },
    {
        "id": "node-parse-heartbeat",
        "type": "function",
        "z": "flow-heartbeat",
        "name": "Parse Heartbeat & Format Status",
        "func": "try {\n    const data = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n    const state = data.state || 'UNKNOWN';\n    const status = data.status || 'ok';\n    const ts = data.ts ? new Date(data.ts * 1000).toLocaleTimeString('id-ID') : new Date().toLocaleTimeString('id-ID');\n\n    msg.payload = `✅ Device: ONLINE — State: ${state} | Status: ${status} | Last: ${ts}`;\n    msg.deviceOnline = true;\n    return msg;\n} catch (e) {\n    node.warn('Failed to parse heartbeat: ' + e.message);\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 140,
        "wires": [
            ["node-ui-device-status", "node-heartbeat-trigger"]
        ]
    },
    {
        "id": "node-ui-device-status",
        "type": "ui-text",
        "z": "flow-heartbeat",
        "group": "ui-group-device",
        "name": "Device Status Display",
        "order": 1,
        "width": "6",
        "height": "1",
        "label": "ESP32-S3 Terminal",
        "format": "{{msg.payload}}",
        "layout": "row-left",
        "style": false,
        "font": "14px",
        "color": "#cdd6f4",
        "className": "",
        "x": 780,
        "y": 100,
        "wires": []
    },
    {
        "id": "node-heartbeat-trigger",
        "type": "trigger",
        "z": "flow-heartbeat",
        "name": "Timeout 60s → OFFLINE",
        "op1": "",
        "op2": "❌ Device: OFFLINE — No heartbeat received for >60 seconds",
        "op1type": "nul",
        "op2type": "str",
        "duration": "60",
        "extend": true,
        "overrideDelay": false,
        "units": "s",
        "reset": "",
        "bytopic": "all",
        "topic": "topic",
        "outputs": 1,
        "x": 790,
        "y": 180,
        "wires": [
            ["node-ui-device-status"]
        ]
    },

