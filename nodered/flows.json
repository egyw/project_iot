    {
        "id": "node-parse-stats",
        "type": "function",
        "z": "flow-stats",
        "name": "Parse Stats Response",
        "func": "try {\n    const body = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n    const stats = body.data;\n\n    if (!stats) {\n        node.warn('No data in stats response');\n        return null;\n    }\n\n    // Output 1: Available Assets (for gauge)\n    const msg1 = { payload: stats.available_assets, total: stats.total_assets };\n    // Output 2: Active Sessions\n    const msg2 = { payload: `🔄 ${stats.active_sessions}` };\n    // Output 3: Borrows Today\n    const msg3 = { payload: `📦 ${stats.borrows_today}` };\n    // Output 4: Total Assets label\n    const msg4 = { payload: `🏷️ ${stats.total_assets}` };\n    // Output 5: Borrows This Week\n    const msg5 = { payload: `📅 ${stats.borrows_this_week}` };\n\n    return [msg1, msg2, msg3, msg4, msg5];\n} catch (e) {\n    node.warn('Failed to parse stats: ' + e.message);\n    return [null, null, null, null, null];\n}",
        "outputs": 5,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 900,
        "y": 160,
        "wires": [
            ["node-ui-gauge-available"],
            ["node-ui-text-active"],
            ["node-ui-text-borrows-today"],
            ["node-ui-text-total"],
            ["node-ui-text-borrows-week"]
        ]
    },
